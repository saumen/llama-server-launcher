# Path to llama-server binary

# shellcheck disable=SC2034  # Unused variables left for readability
LLAMA_SERVER_BIN="/opt/llama.cpp/build/bin/llama-server"
HF_CACHE_DIR="${HOME}/.cache/huggingface/hub"
HF_UNSLOTH_DIR="${HF_CACHE_DIR}/unsloth"

# Redirect llama.cpp's HF cache scan to an empty dir so only INI presets appear (no auto-scan of downloaded GGUFs)
export LLAMA_CACHE="/tmp/llama-cpp-empty-cache"
